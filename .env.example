# Generate a unique value for deployments: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
HOST=127.0.0.1
PORT=5000
# Set to 1 outside local development to fail startup if SECRET_KEY is weak or missing.
# REQUIRE_SECRET_KEY=1
# Set to your exact origin(s) only when using a separate frontend origin.
# CORS_ORIGINS=https://chat.example.com
# Set to 1 only when serving over HTTPS.
COOKIE_SECURE=0
# ADMIN_USERNAME=admin
